{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergeAll"
  ],
  "platformAutomerge": false,
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchPackageNames": ["org.eclipse.platform:**"],
      "minimumReleaseAge": "7 days"
    }
  ]
}
